# Common environment example for local development.
# Copy this file to .env on Windows/macOS/Linux development machines.
# Ubuntu production still uses /etc/esports-site-selection/backend.env.

# Runtime mode
APP_ENV=development
APP_VERSION=v1.0.0-beta

# Database
# Windows local PostgreSQL example:
DATABASE_URL=postgresql+psycopg://site_selection:change_this_strong_password@localhost:5432/site_selection

# Optional PostgreSQL bootstrap variables used by Docker or local setup notes.
POSTGRES_DB=site_selection
POSTGRES_USER=site_selection
POSTGRES_PASSWORD=change_this_strong_password

# AMap
# Backend Web Service Key. Keep private; never put it in frontend runtime config.
AMAP_WEB_SERVICE_KEY=
AMAP_MOCK=false

# Frontend public AMap JavaScript config for Windows/Vite dev.
# This key is visible to the browser. Restrict it by domain/referer in AMap console.
VITE_AMAP_JS_KEY=
VITE_AMAP_SECURITY_JS_CODE=
MAP_PROVIDER=amap

# Agent / observability switches
ENABLE_TRACE=true
ENABLE_FEEDBACK=true
ENABLE_REFLECTION=true
ENABLE_SIMILAR_CASES=true
ENABLE_DEBUG_API=false
ENABLE_DEBUG_ENDPOINTS=false

# Local development data files
SITE_FEEDBACK_STORE_PATH=data/site_feedback.json
AGENT_TRACE_STORE_PATH=data/agent_traces.json
FRONTEND_RUNTIME_CONFIG_PATH=frontend/public/runtime-config.json

# Scoring
SCORING_CONFIG_PATH=app/scoring/default.yaml

# DeepSeek AI report/chat.
# Missing API key must not stop backend startup; AI endpoints should return a clear message.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Crawler data enrichment. Disabled by default.
CRAWLER_ENABLED=false
CRAWLER_PROVIDER=crawl4ai
CRAWLER_TIMEOUT_SECONDS=60
CRAWLER_MAX_PAGES_PER_TASK=5
CRAWLER_MAX_TASKS_PER_PROJECT=50
CRAWLER_RATE_LIMIT_SECONDS=5
CRAWLER_ALLOWED_DOMAINS=
CRAWLER_BLOCKED_DOMAINS=
CRAWLER_SEARCH_ENABLED=true
CRAWLER_SEARCH_PROVIDER=bing_html
CRAWLER_SEARCH_MAX_RESULTS=5
CRAWLER_SEARCH_TIMEOUT_SECONDS=10
CRAWLER_SEARCH_ALLOWED_DOMAINS=

# 政府公开数据（无需 Key）
GOV_DATA_ENABLED=true
GOV_DATA_SOURCES=national,shaanxi,xian
GOV_DATA_TIMEOUT_SECONDS=15
GOV_DATA_MAX_RETRIES=2
GOV_DATA_RATE_LIMIT_SECONDS=1
GOV_DATA_USER_AGENT="esports-site-selection/1.0 (+government-public-data)"

# Web 配置中心安全设置。加密主密钥至少使用32位随机字符串，管理Token使用独立强密码。
SYSTEM_CONFIG_ENCRYPTION_KEY=
ADMIN_CONFIG_TOKEN=

# Local service URLs
APP_BASE_URL=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Production note:
# Ubuntu production config is stored in:
#   /etc/esports-site-selection/backend.env
#   /etc/esports-site-selection/frontend-runtime.json
